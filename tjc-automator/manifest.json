{
  "manifest_version": 3,
  "name": "TJC Service Flow Automator",
  "version": "1.0.0",
  "description": "Automates sermon details and hymns sequential autofilling on service.tjc.org from Google Sheets.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://service.tjc.org/*",
    "*://docs.google.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://service.tjc.org/*",
        "*://*.service.tjc.org/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css"],
      "matches": [
        "*://service.tjc.org/*",
        "*://*.service.tjc.org/*"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  }
}
